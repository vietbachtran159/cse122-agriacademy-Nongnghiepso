<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
git init
git add .
git commit -m "Push code"
git branch -M main
git remote add origin https://github.com/vietbachtran159/ten-repo.git
git push -u origin main
<title>AgriAcademy – Học Nông nghiệp trực quan</title>
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
--bg:#f6f8f2;--sf:#fff;--tx:#1f2a1c;--mu:#5f6e5a;--bd:#dde5d4;--pr:#2f7d32;--pr2:#e4f1df;--wa:#b26a00;--er:#b3261e;
--c1:#8ecae6;--c2:#a7d98b;--c3:#ffd166;--c4:#f4978e}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#121a11;--sf:#1b261a;--tx:#e8f0e3;--mu:#9bab95;--bd:#2c3a2a;--pr:#6fcf73;--pr2:#223a21;--wa:#ffb74d;--er:#ff8a80;--c1:#2b6a85;--c2:#3f7a2b;--c3:#8a6a10;--c4:#8a3a33}}
:root[data-theme="dark"]{--bg:#121a11;--sf:#1b261a;--tx:#e8f0e3;--mu:#9bab95;--bd:#2c3a2a;--pr:#6fcf73;--pr2:#223a21;--wa:#ffb74d;--er:#ff8a80;--c1:#2b6a85;--c2:#3f7a2b;--c3:#8a6a10;--c4:#8a3a33}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--sf);z-index:10}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:9;background:var(--sf);border-bottom:1px solid var(--bd);display:flex;flex-wrap:wrap;gap:8px 16px;align-items:center;padding:10px 16px}
.brand{font-weight:700;font-size:1.15rem;color:var(--pr);text-decoration:none}
nav{display:flex;flex-wrap:wrap;gap:4px;flex:1}
nav a{padding:6px 12px;border-radius:999px;text-decoration:none;color:var(--tx);font-size:.92rem}
nav a:hover{background:var(--pr2)}nav a.on{background:var(--pr);color:#fff}
.tools{display:flex;gap:8px;align-items:center}
main{max-width:1000px;margin:0 auto;padding:20px 16px 48px}
h1{font-size:1.6rem;margin:.2em 0 .4em}h2{font-size:1.15rem;margin:0 0 .6em}
.card{background:var(--sf);border:1px solid var(--bd);border-radius:14px;padding:16px}
.grid{display:grid;gap:12px;grid-template-columns:repeat(auto-fill,minmax(220px,1fr))}
.hero{background:linear-gradient(135deg,var(--pr2),var(--sf));border:1px solid var(--bd);border-radius:18px;padding:24px;margin-bottom:16px}
.hero p{color:var(--mu);max-width:60ch}
button,select,input,textarea{font:inherit;color:var(--tx);background:var(--sf);border:1px solid var(--bd);border-radius:10px;padding:8px 12px}
button{cursor:pointer}button.pr{background:var(--pr);color:#fff;border-color:var(--pr)}
button.sm{padding:3px 9px;font-size:.85rem}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--pr);outline-offset:2px}
label{display:block;font-size:.88rem;color:var(--mu);margin:8px 0 3px}
input,select,textarea{width:100%}
.row{display:flex;flex-wrap:wrap;gap:12px}.row>*{flex:1 1 200px}
.bar{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px}.bar>*{flex:1 1 160px}
.badge{display:inline-block;padding:2px 10px;border-radius:999px;font-size:.78rem;background:var(--pr2);color:var(--pr)}
.badge.cao,.badge.rejected{background:#fde4e1;color:var(--er)}.badge.tb,.badge.pending{background:#fff0d6;color:var(--wa)}
.badge.approved{background:var(--pr2);color:var(--pr)}
.muted{color:var(--mu);font-size:.9rem}
.err{color:var(--er);font-size:.85rem;min-height:1.2em}
.empty{text-align:center;color:var(--mu);padding:28px;border:1px dashed var(--bd);border-radius:14px}
.cal{display:grid;grid-template-columns:repeat(7,1fr);gap:3px}
.cal div{min-height:48px;border-radius:8px;border:1px solid var(--bd);padding:3px 5px;font-size:.82rem;background:var(--sf)}
.cal .h{min-height:0;border:0;background:none;text-align:center;color:var(--mu)}
.p0{background:var(--c1)!important}.p1{background:var(--c2)!important}.p2{background:var(--c3)!important}.p3{background:var(--c4)!important}
.dot{display:inline-block;width:12px;height:12px;border-radius:4px;vertical-align:middle;margin-right:6px}
.scroll{overflow-x:auto}table{border-collapse:collapse;width:100%;min-width:480px}
th,td{text-align:left;padding:8px;border-bottom:1px solid var(--bd);font-size:.92rem}
.chips{display:flex;flex-wrap:wrap;gap:6px}.chips label{display:flex;gap:6px;align-items:center;margin:0;border:1px solid var(--bd);border-radius:999px;padding:4px 12px;color:var(--tx);cursor:pointer}
.chips input{width:auto}
.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(20px + env(safe-area-inset-bottom,0px));background:var(--tx);color:var(--bg);padding:10px 18px;border-radius:10px;z-index:20}
[hidden]{display:none!important}
</style>
</head>
<body>
<header>
  <a class="brand" href="#home">🌾 AgriAcademy</a>
  <nav id="nav" aria-label="Điều hướng chính"></nav>
  <div class="tools">
    <label for="role" class="muted" style="margin:0">Vai trò</label>
    <select id="role" style="width:auto"><option value="guest">Khách</option><option value="student" selected>Sinh viên</option><option value="teacher">Giảng viên</option><option value="admin">Quản trị viên</option></select>
    <button id="theme" class="sm" aria-label="Đổi giao diện sáng/tối">◐</button>
  </div>
</header>
<main id="main" tabindex="-1"></main>
<div id="toast" class="toast" role="status" hidden></div>

<script>
const $=s=>document.querySelector(s);
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const PH=['Gieo','Chăm sóc','Bón phân','Thu hoạch'];
const crops=[
{id:1,name:'Lúa',icon:'🌾',region:'Đồng bằng sông Hồng',season:'Xuân–Hè',care:['Làm đất','Gieo mạ','Cấy','Bón thúc','Thu hoạch'],ph:[[0,10],[10,45],[55,20],[120,15]]},
{id:2,name:'Ngô',icon:'🌽',region:'Trung du miền núi phía Bắc',season:'Xuân',care:['Làm đất','Gieo hạt','Tỉa dặm','Bón thúc','Thu bắp'],ph:[[0,7],[7,40],[30,25],[95,10]]},
{id:3,name:'Cà chua',icon:'🍅',region:'Đà Lạt',season:'Đông–Xuân',care:['Ươm giống','Trồng','Làm giàn','Bón phân','Hái quả'],ph:[[0,14],[14,40],[30,40],[80,40]]},
{id:4,name:'Cà phê',icon:'☕',region:'Tây Nguyên',season:'Quanh năm',care:['Trồng','Tưới','Tạo hình','Bón phân','Thu hái'],ph:[[0,20],[20,120],[60,60],[240,45]]},
{id:5,name:'Chè',icon:'🍃',region:'Thái Nguyên',season:'Xuân–Thu',care:['Trồng','Đốn tạo tán','Bón phân','Hái búp'],ph:[[0,15],[15,60],[40,30],[90,20]]},
{id:6,name:'Rau muống',icon:'🥬',region:'Đồng bằng sông Hồng',season:'Hè',care:['Gieo','Tưới','Bón phân','Thu hoạch'],ph:[[0,3],[3,15],[10,10],[28,10]]}];
const pests0=[
{id:1,name:'Sâu cuốn lá',crop:1,sym:['lá quăn','lá bị cuốn','đốm trắng trên lá'],harm:'cao',rem:'Phun thuốc sinh học (Bt) + bẫy dẫn dụ; giữ ruộng thoáng.',st:'approved'},
{id:2,name:'Đạo ôn',crop:1,sym:['đốm hình thoi','lá cháy','cổ bông gãy'],harm:'cao',rem:'Bón cân đối đạm; phun Tricyclazole khi mới xuất hiện.',st:'approved'},
{id:3,name:'Sâu đục thân',crop:2,sym:['đục thân','lá héo','lỗ đục trên thân'],harm:'tb',rem:'Rải hạt xử lý đọt, thu gom tàn dư sau vụ.',st:'approved'},
{id:4,name:'Bệnh mốc sương',crop:3,sym:['đốm nâu trên lá','lá úa vàng','quả thối'],harm:'cao',rem:'Tỉa lá già, giàn thoáng, phun thuốc gốc đồng.',st:'approved'},
{id:5,name:'Rệp sáp',crop:4,sym:['lá vàng','chồi non quăn','có sáp trắng'],harm:'tb',rem:'Phun dầu khoáng, kiểm soát kiến, tỉa cành.',st:'pending'},
{id:6,name:'Rầy xanh',crop:5,sym:['lá vàng','búp cháy mép','lá quăn'],harm:'tb',rem:'Hái sớm, dùng bẫy dính vàng, chế phẩm nấm xanh.',st:'approved'}];
const users0=[{id:1,name:'Nguyễn An',role:'Sinh viên',email:'an@agri.edu',on:true},{id:2,name:'Trần Bình',role:'Giảng viên',email:'binh@agri.edu',on:true},{id:3,name:'Lê Chi',role:'Sinh viên',email:'chi@agri.edu',on:false},{id:4,name:'Phạm Dũng',role:'Quản trị viên',email:'dung@agri.edu',on:true}];
const subs0=[{id:1,sv:'Nguyễn An',ex:'Chẩn đoán lá lúa vàng',score:'',st:'pending'},{id:2,sv:'Lê Chi',ex:'Lịch vụ ngô xuân',score:8,st:'approved'},{id:3,sv:'Hoàng Em',ex:'Quy trình bón phân chè',score:'',st:'pending'}];
let pests=pests0,users=users0,subs=subs0;
let journal=[];try{journal=JSON.parse(localStorage.getItem('agri-journal')||'[]')}catch(e){}
if(!journal.length)journal=[{id:1,date:'2026-11-20',crop:1,act:'Bón thúc đợt 1',note:'Bón 5 kg urê/sào, ruộng đủ nước.'}];
const save=()=>{try{localStorage.setItem('agri-journal',JSON.stringify(journal))}catch(e){}};
const toast=m=>{const t=$('#toast');t.textContent=m;t.hidden=false;clearTimeout(toast.t);toast.t=setTimeout(()=>t.hidden=true,2200)};
const cn=id=>(crops.find(c=>c.id==id)||{}).name||'';
const cropOpts=(sel)=>crops.map(c=>`<option value="${c.id}"${c.id==sel?' selected':''}>${c.icon} ${c.name}</option>`).join('');
const views={
 guest:['home','crops'],student:['home','crops','season','journal','pest'],teacher:['home','crops','manage'],admin:['home','manage']};
const names={home:'Trang chủ',crops:'Thư viện cây',season:'Lịch mùa vụ',journal:'Nhật ký',pest:'Chẩn đoán',manage:'Quản lý'};
let role='student';
const cal={crop:1,start:'2026-12-01',shift:[0,0,0,0],y:2026,m:11};
const pad=n=>String(n).padStart(2,'0'),iso=d=>`${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
const addD=(s,n)=>{const [y,m,d]=s.split('-').map(Number);return new Date(y,m-1,d+n)};

function nav(){const cur=(location.hash||'#home').slice(1);
 $('#nav').innerHTML=views[role].map(v=>`<a href="#${v}"${v==cur?' class="on" aria-current="page"':''}>${names[v]}</a>`).join('')}
function route(){let v=(location.hash||'#home').slice(1);const ok=views[role];
 if(!names[v])v='home';
 nav();const m=$('#main');
 if(!ok.includes(v)){m.innerHTML=`<div class="empty"><h1>403</h1><p>Vai trò hiện tại không có quyền xem màn hình này.</p><a href="#home">Về trang chủ</a></div>`;return}
 m.innerHTML=R[v]();(B[v]||(()=>{}))();}

const R={};const B={};
R.home=()=>{const msg={guest:'Xem công khai thư viện cây trồng và lộ trình môn học.',student:'Lập lịch mùa vụ, ghi nhật ký và luyện chẩn đoán sâu bệnh.',teacher:'Quản lý hồ sơ cây, bài giảng và chấm bài nộp.',admin:'Quản lý tài khoản và duyệt thư viện sâu bệnh.'}[role];
 const ways=[['season','📅','Lịch mùa vụ tương tác','Các giai đoạn tô màu, dời được theo vùng/cây.'],['journal','📓','Nhật ký canh tác','Ghi hoạt động theo ngày, đối chiếu quy trình.'],['pest','🔍','Chẩn đoán sâu bệnh','Chọn cây + triệu chứng, nhận kết luận sơ bộ.'],['crops','🌱','Thư viện cây trồng','Quy trình chăm sóc từng bước theo vùng.']].filter(w=>views[role].includes(w[0]));
 return `<section class="hero"><h1>Chào mừng đến AgriAcademy</h1><p>${msg}</p><div class="chips" style="margin-top:8px"><span class="badge">${crops.length} cây trồng</span><span class="badge">${pests.filter(p=>p.st=='approved').length} hồ sơ sâu bệnh</span><span class="badge">Vai trò: ${$('#role').selectedOptions[0].text}</span></div></section>
 <h2>Cách học trực quan</h2><div class="grid">${ways.map(w=>`<a class="card" href="#${w[0]}" style="text-decoration:none;color:inherit"><div style="font-size:1.8rem">${w[1]}</div><strong>${w[2]}</strong><p class="muted">${w[3]}</p></a>`).join('')}</div>
 ${role=='guest'?'<p class="muted">Đăng nhập để dùng lịch mùa vụ, nhật ký và chẩn đoán (chọn vai trò Sinh viên ở góc trên).</p>':''}`};

R.crops=()=>`<h1>Thư viện cây trồng</h1><div class="bar"><input id="q" type="search" placeholder="Tìm theo tên cây…" aria-label="Tìm cây"><select id="rg" aria-label="Lọc vùng"><option value="">Tất cả vùng</option>${[...new Set(crops.map(c=>c.region))].map(r=>`<option>${r}</option>`).join('')}</select></div>
 ${role=='teacher'?`<details class="card" style="margin-bottom:12px"><summary>＋ Thêm hồ sơ cây</summary><div class="row"><div><label for="nn">Tên cây</label><input id="nn"></div><div><label for="nr">Vùng</label><input id="nr"></div></div><div class="err" id="ne"></div><button class="pr" id="na">Lưu hồ sơ</button></details>`:''}
 <div id="cl" class="grid"></div>`;
B.crops=()=>{const draw=()=>{const q=$('#q').value.toLowerCase(),r=$('#rg').value;const l=crops.filter(c=>c.name.toLowerCase().includes(q)&&(!r||c.region==r));
 $('#cl').innerHTML=l.length?l.map(c=>`<article class="card"><div style="font-size:1.8rem">${c.icon}</div><h2>${esc(c.name)}</h2><p class="muted">${esc(c.region)} · ${esc(c.season)}</p><ol style="padding-left:18px;margin:0">${c.care.map(s=>`<li>${esc(s)}</li>`).join('')}</ol></article>`).join(''):'<div class="empty" style="grid-column:1/-1">Không tìm thấy cây phù hợp.</div>'};
 $('#q').oninput=draw;$('#rg').onchange=draw;draw();
 if($('#na'))$('#na').onclick=()=>{const n=$('#nn').value.trim(),r=$('#nr').value.trim();if(n.length<2||!r){$('#ne').textContent='Nhập tên (≥2 ký tự) và vùng canh tác.';return}
  crops.push({id:crops.length+1,name:n,icon:'🌿',region:r,season:'Chưa đặt',care:['Chưa có quy trình'],ph:[[0,7],[7,30],[20,20],[60,10]]});toast('Đã thêm hồ sơ cây');route()}};

R.season=()=>`<h1>Lịch mùa vụ</h1><div class="card" style="margin-bottom:12px"><div class="row"><div><label for="sc">Cây trồng</label><select id="sc">${cropOpts(cal.crop)}</select></div><div><label for="ss">Ngày bắt đầu gieo</label><input type="date" id="ss" value="${cal.start}"></div></div></div>
 <div class="row" style="align-items:flex-start"><div class="card" style="flex:2 1 380px"><div class="bar" style="align-items:center"><button id="pm" aria-label="Tháng trước">‹</button><strong id="mt" style="text-align:center"></strong><button id="nm" aria-label="Tháng sau">›</button></div><div id="cg" class="cal"></div></div>
 <div class="card" style="flex:1 1 240px"><h2>Giai đoạn</h2><div id="pl"></div><p class="muted">Dùng nút ±7 ngày để dời giai đoạn theo vùng/thời tiết.</p></div></div>`;
B.season=()=>{const phases=()=>{const c=crops.find(x=>x.id==cal.crop);return c.ph.map((p,i)=>({n:PH[i],a:addD(cal.start,p[0]+cal.shift[i]),b:addD(cal.start,p[0]+cal.shift[i]+p[1])}))};
 const draw=()=>{const ps=phases(),f=new Date(cal.y,cal.m,1),days=new Date(cal.y,cal.m+1,0).getDate(),off=(f.getDay()+6)%7;
  $('#mt').textContent=`Tháng ${cal.m+1}/${cal.y}`;
  let h=['T2','T3','T4','T5','T6','T7','CN'].map(d=>`<div class="h">${d}</div>`).join('')+'<div style="border:0;background:none"></div>'.repeat(off);
  for(let d=1;d<=days;d++){const dt=new Date(cal.y,cal.m,d);const i=ps.findIndex(p=>dt>=p.a&&dt<=p.b);h+=`<div class="${i>=0?'p'+i:''}" ${i>=0?`title="${PH[i]}"`:''}>${d}</div>`}
  $('#cg').innerHTML=h;
  $('#pl').innerHTML=ps.map((p,i)=>`<div style="margin-bottom:10px"><span class="dot p${i}"></span><strong>${p.n}</strong><div class="muted">${p.a.toLocaleDateString('vi-VN')} → ${p.b.toLocaleDateString('vi-VN')}</div><button class="sm" data-i="${i}" data-d="-7">−7 ngày</button> <button class="sm" data-i="${i}" data-d="7">+7 ngày</button></div>`).join('');
  document.querySelectorAll('#pl button').forEach(b=>b.onclick=()=>{cal.shift[b.dataset.i]+=+b.dataset.d;draw()})};
 $('#sc').onchange=e=>{cal.crop=+e.target.value;cal.shift=[0,0,0,0];draw()};
 $('#ss').onchange=e=>{if(!e.target.value)return;cal.start=e.target.value;const d=addD(cal.start,0);cal.y=d.getFullYear();cal.m=d.getMonth();draw()};
 $('#pm').onclick=()=>{cal.m--;if(cal.m<0){cal.m=11;cal.y--}draw()};$('#nm').onclick=()=>{cal.m++;if(cal.m>11){cal.m=0;cal.y++}draw()};draw()};

R.journal=()=>`<h1>Nhật ký canh tác</h1><div class="row" style="align-items:flex-start"><form class="card" id="jf" novalidate style="flex:1 1 280px"><h2>Ghi hoạt động</h2><label for="jd">Ngày</label><input type="date" id="jd"><label for="jc">Cây trồng</label><select id="jc">${cropOpts(1)}</select><label for="ja">Hoạt động</label><input id="ja" placeholder="VD: Bón thúc đợt 1"><label for="jn">Ghi chú</label><textarea id="jn" rows="3"></textarea><div class="err" id="je" role="alert"></div><button class="pr" type="submit">Lưu nhật ký</button></form>
 <div style="flex:2 1 360px"><div class="bar"><select id="jf2" aria-label="Lọc cây"><option value="">Tất cả cây</option>${cropOpts()}</select></div><div id="jl"></div></div></div>`;
B.journal=()=>{$('#jd').value=iso(new Date());
 const draw=()=>{const f=$('#jf2').value;const l=journal.filter(j=>!f||j.crop==f).sort((a,b)=>b.date.localeCompare(a.date));
  $('#jl').innerHTML=l.length?l.map(j=>`<div class="card" style="margin-bottom:8px"><div style="display:flex;justify-content:space-between;gap:8px"><strong>${esc(j.act)}</strong><span class="badge">${cn(j.crop)} · ${j.date}</span></div><p class="muted" style="margin:.3em 0">${esc(j.note)||'Không có ghi chú'}</p><button class="sm" data-id="${j.id}">Xóa</button></div>`).join(''):'<div class="empty">Chưa có nhật ký nào. Hãy ghi hoạt động đầu tiên!</div>';
  document.querySelectorAll('#jl button').forEach(b=>b.onclick=()=>{journal=journal.filter(j=>j.id!=b.dataset.id);save();draw();toast('Đã xóa')})};
 $('#jf2').onchange=draw;
 $('#jf').onsubmit=e=>{e.preventDefault();const a=$('#ja').value.trim(),d=$('#jd').value;
  if(!d||a.length<3){$('#je').textContent='Chọn ngày và nhập hoạt động (≥3 ký tự).';return}
  $('#je').textContent='';journal.push({id:Date.now(),date:d,crop:+$('#jc').value,act:a,note:$('#jn').value.trim()});save();$('#ja').value='';$('#jn').value='';draw();toast('Đã lưu nhật ký')};draw()};

R.pest=()=>`<h1>Chẩn đoán sâu bệnh</h1><div class="card" style="margin-bottom:12px"><label for="pc">Cây trồng</label><select id="pc">${cropOpts(1)}</select><label>Triệu chứng quan sát được</label><div id="ps" class="chips"></div><label for="pt">Mô tả thêm (tùy chọn)</label><input id="pt" placeholder="VD: lá vàng, có sáp trắng"><div class="err" id="pe" role="alert"></div><button class="pr" id="pg">Chẩn đoán</button></div><div id="pr"></div>`;
B.pest=()=>{const ap=()=>pests.filter(p=>p.st=='approved');
 const syms=()=>{const s=[...new Set(ap().filter(p=>p.crop==$('#pc').value).flatMap(p=>p.sym))];$('#ps').innerHTML=s.length?s.map(x=>`<label><input type="checkbox" value="${esc(x)}">${esc(x)}</label>`).join(''):'<span class="muted">Chưa có hồ sơ sâu bệnh cho cây này.</span>';$('#pr').innerHTML=''};
 $('#pc').onchange=syms;syms();
 $('#pg').onclick=()=>{const sel=[...document.querySelectorAll('#ps input:checked')].map(x=>x.value),t=$('#pt').value.toLowerCase();
  if(!sel.length&&t.trim().length<3){$('#pe').textContent='Chọn ít nhất một triệu chứng hoặc nhập mô tả.';return}$('#pe').textContent='';
  const res=ap().filter(p=>p.crop==$('#pc').value).map(p=>{const hit=p.sym.filter(s=>sel.includes(s)||(t&&t.includes(s)));return{p,hit,sc:hit.length/p.sym.length}}).filter(r=>r.hit.length).sort((a,b)=>b.sc-a.sc);
  $('#pr').innerHTML=res.length?res.map(r=>`<div class="card" style="margin-bottom:8px"><div style="display:flex;justify-content:space-between;gap:8px"><strong>${esc(r.p.name)}</strong><span class="badge ${r.p.harm}">Thiệt hại: ${r.p.harm=='cao'?'cao':'trung bình'}</span></div><p class="muted">Khớp ${r.hit.length}/${r.p.sym.length} triệu chứng (${Math.round(r.sc*100)}%): ${r.hit.map(esc).join(', ')}</p><p><strong>Phòng trị:</strong> ${esc(r.p.rem)}</p><button class="sm" onclick="toast('Đã lưu kết luận')">Lưu</button> <button class="sm" onclick="toast('Đã báo cáo cho giảng viên')">Báo cáo sai</button></div>`).join('')+'<p class="muted">Đây là kết luận sơ bộ theo quy tắc khớp triệu chứng, hãy kiểm chứng thực tế.</p>':'<div class="empty">Không đủ dữ liệu để kết luận. Thử thêm triệu chứng hoặc nhập thủ công.</div>'}};

R.manage=()=>role=='teacher'?`<h1>Chấm bài &amp; phản hồi</h1><div class="card scroll"><table><thead><tr><th>Sinh viên</th><th>Bài tập</th><th>Điểm</th><th>Trạng thái</th><th></th></tr></thead><tbody id="tb"></tbody></table></div>`
 :`<h1>Quản trị</h1><div class="grid" style="margin-bottom:12px"><div class="card"><h2>${users.length}</h2><span class="muted">Tài khoản</span></div><div class="card"><h2>${pests.filter(p=>p.st=='pending').length}</h2><span class="muted">Sâu bệnh chờ duyệt</span></div><div class="card"><h2>${users.filter(u=>!u.on).length}</h2><span class="muted">Bị vô hiệu hóa</span></div></div>
 <h2>Người dùng</h2><div class="card scroll" style="margin-bottom:16px"><table><thead><tr><th>Tên</th><th>Vai trò</th><th>Email</th><th></th></tr></thead><tbody id="ut"></tbody></table></div><h2>Duyệt thư viện sâu bệnh</h2><div class="card scroll"><table><thead><tr><th>Tên</th><th>Cây</th><th>Trạng thái</th><th></th></tr></thead><tbody id="pt2"></tbody></table></div>`;
B.manage=()=>{const bd=s=>`<span class="badge ${s}">${{pending:'Đang chờ',approved:'Đã duyệt',rejected:'Bị từ chối'}[s]}</span>`;
 if(role=='teacher'){const d=()=>{$('#tb').innerHTML=subs.map(s=>`<tr><td>${esc(s.sv)}</td><td>${esc(s.ex)}</td><td><input type="number" min="0" max="10" value="${s.score}" data-id="${s.id}" style="width:80px" aria-label="Điểm"></td><td>${bd(s.st)}</td><td><button class="sm" data-id="${s.id}">Chấm</button></td></tr>`).join('');
  document.querySelectorAll('#tb button').forEach(b=>b.onclick=()=>{const i=document.querySelector(`#tb input[data-id="${b.dataset.id}"]`),v=i.value;if(v===''||v<0||v>10){toast('Điểm phải từ 0 đến 10');return}const s=subs.find(x=>x.id==b.dataset.id);s.score=+v;s.st='approved';d();toast('Đã trả điểm')})};d()}
 else{const u=()=>{$('#ut').innerHTML=users.map(x=>`<tr><td>${esc(x.name)}</td><td>${x.role}</td><td>${esc(x.email)}</td><td><button class="sm" data-id="${x.id}">${x.on?'Vô hiệu hóa':'Kích hoạt'}</button></td></tr>`).join('');
  document.querySelectorAll('#ut button').forEach(b=>b.onclick=()=>{const x=users.find(y=>y.id==b.dataset.id);x.on=!x.on;u();toast('Đã cập nhật tài khoản')})};
  const p=()=>{$('#pt2').innerHTML=pests.map(x=>`<tr><td>${esc(x.name)}</td><td>${cn(x.crop)}</td><td>${bd(x.st)}</td><td><button class="sm" data-id="${x.id}" data-s="approved">Duyệt</button> <button class="sm" data-id="${x.id}" data-s="rejected">Từ chối</button></td></tr>`).join('');
  document.querySelectorAll('#pt2 button').forEach(b=>b.onclick=()=>{pests.find(y=>y.id==b.dataset.id).st=b.dataset.s;p();toast('Đã cập nhật hồ sơ')})};u();p()}};

$('#role').onchange=e=>{role=e.target.value;route()};
$('#theme').onclick=()=>{const r=document.documentElement,d=getComputedStyle(r).getPropertyValue('--bg').trim()=='#121a11';r.dataset.theme=d?'light':'dark'};
addEventListener('hashchange',route);route();
</script>
</body>
</html>
